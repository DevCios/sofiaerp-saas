<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_pos_express_user" model="res.groups">
            <field name="name">POS Express: Cajero</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pos_express_manager" model="res.groups">
            <field name="name">POS Express: Administrador</field>
            <field name="implied_ids" eval="[(4, ref('group_pos_express_user'))]"/>
        </record>

        <record id="rule_pos_express_config_company" model="ir.rule">
            <field name="name">POS Express Config multi-company</field>
            <field name="model_id" ref="model_pos_express_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_pos_express_session_company" model="ir.rule">
            <field name="name">POS Express Session multi-company</field>
            <field name="model_id" ref="model_pos_express_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
