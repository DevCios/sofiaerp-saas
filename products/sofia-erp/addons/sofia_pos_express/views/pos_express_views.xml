<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- CAJAS POS EXPRESS (KANBAN + FORM + LIST)                           -->
    <!-- ================================================================== -->
    <record id="view_pos_express_config_kanban" model="ir.ui.view">
        <field name="name">pos.express.config.kanban</field>
        <field name="model">pos.express.config</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="company_id"/>
                <field name="current_session_id"/>
                <field name="open_session_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="fs-5"><field name="name"/></strong>
                                <div class="text-muted small"><field name="company_id"/></div>
                            </div>
                            <span t-if="record.open_session_count.raw_value" class="badge text-bg-success">Turno Abierto</span>
                            <span t-else="" class="badge text-bg-secondary">Cerrado</span>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button t-if="record.open_session_count.raw_value"
                                    name="action_resume_session"
                                    type="object"
                                    class="btn btn-primary btn-sm">
                                Reanudar POS Express
                            </button>
                            <button t-else=""
                                    name="action_open_session"
                                    type="object"
                                    class="btn btn-primary btn-sm">
                                Abrir Turno POS Express
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pos_express_config_list" model="ir.ui.view">
        <field name="name">pos.express.config.list</field>
        <field name="model">pos.express.config</field>
        <field name="arch" type="xml">
            <list string="Cajas POS Express">
                <field name="name"/>
                <field name="company_id"/>
                <field name="current_session_id"/>
                <field name="auto_send_sunat"/>
                <field name="auto_deduct_stock"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pos_express_config_form" model="ir.ui.view">
        <field name="name">pos.express.config.form</field>
        <field name="model">pos.express.config</field>
        <field name="arch" type="xml">
            <form string="Caja POS Express">
                <header>
                    <button name="action_open_session" string="Abrir Turno POS Express" type="object" class="btn-primary" invisible="current_session_id"/>
                    <button name="action_resume_session" string="Reanudar Terminal POS" type="object" class="btn-primary" invisible="not current_session_id"/>
                    <button name="action_sync_yape_plin" string="Habilitar Yape y Plin" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Caja Principal"/></h1>
                    </div>
                    <group>
                        <group string="General y SUNAT">
                            <field name="company_id"/>
                            <field name="header_title"/>
                            <field name="user_id"/>
                            <field name="auto_send_sunat" widget="boolean_toggle"/>
                            <field name="price_includes_tax" widget="boolean_toggle"/>
                            <field name="enable_discount" widget="boolean_toggle"/>
                        </group>
                        <group string="Diarios y Stock">
                            <field name="journal_ids" widget="many2many_tags"/>
                            <field name="payment_journal_ids" widget="many2many_tags"/>
                            <field name="auto_deduct_stock" widget="boolean_toggle"/>
                            <field name="picking_type_id" invisible="not auto_deduct_stock"/>
                            <field name="stock_location_id" invisible="not auto_deduct_stock"/>
                        </group>
                    </group>
                    <group string="Personalización de Ticket Térmico">
                        <field name="ticket_footer"/>
                        <field name="yape_info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- TURNOS / SESIONES DE CAJA                                          -->
    <!-- ================================================================== -->
    <record id="view_pos_express_session_list" model="ir.ui.view">
        <field name="name">pos.express.session.list</field>
        <field name="model">pos.express.session</field>
        <field name="arch" type="xml">
            <list string="Turnos POS Express">
                <field name="name"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <field name="start_at"/>
                <field name="stop_at"/>
                <field name="cash_real_transaction" sum="Total Efectivo"/>
                <field name="cash_real_bank" sum="Total Bancos/Yape"/>
                <field name="cash_register_difference"/>
                <field name="state" widget="badge" decoration-success="state == 'opened'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_pos_express_session_form" model="ir.ui.view">
        <field name="name">pos.express.session.form</field>
        <field name="model">pos.express.session</field>
        <field name="arch" type="xml">
            <form string="Turno POS Express">
                <header>
                    <button name="action_open_terminal" string="Abrir Terminal" type="object" class="btn-primary" invisible="state != 'opened'"/>
                    <button name="action_pos_express_close" string="Cerrar Turno" type="object" class="btn-secondary" invisible="state != 'opened'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Información del Turno">
                            <field name="config_id"/>
                            <field name="company_id"/>
                            <field name="user_id"/>
                            <field name="start_at"/>
                            <field name="stop_at"/>
                        </group>
                        <group string="Arqueo de Caja">
                            <field name="opening_balance"/>
                            <field name="cash_real_transaction"/>
                            <field name="cash_real_bank"/>
                            <field name="net_cash_moves"/>
                            <field name="cash_real_expected"/>
                            <field name="cash_register_balance_end_real"/>
                            <field name="cash_register_difference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comprobantes Emitidos">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="payment_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Movimientos de Efectivo">
                            <field name="cash_move_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="move_type"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas de Cierre">
                            <field name="closing_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- ACCIONES Y MENÚS (APP DRAWER: POS EXPRESS)                         -->
    <!-- ================================================================== -->
    <record id="action_pos_express_config" model="ir.actions.act_window">
        <field name="name">Cajas POS Express</field>
        <field name="res_model">pos.express.config</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_pos_express_session" model="ir.actions.act_window">
        <field name="name">Turnos y Arqueos</field>
        <field name="res_model">pos.express.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pos_express_moves" model="ir.actions.act_window">
        <field name="name">Comprobantes POS Express</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pos_express_session_id', '!=', False)]</field>
    </record>

    <record id="action_pos_express_open_url" model="ir.actions.act_url">
        <field name="name">Abrir Terminal POS Express</field>
        <field name="url">/pos_express</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_pos_express_root" name="POS Express" web_icon="sofia_pos_express,static/description/icon.png" sequence="32"/>
    <menuitem id="menu_pos_express_dashboard" name="Cajas" parent="menu_pos_express_root" action="action_pos_express_config" sequence="10"/>
    <menuitem id="menu_pos_express_terminal" name="Abrir Terminal" parent="menu_pos_express_root" action="action_pos_express_open_url" sequence="15"/>
    <menuitem id="menu_pos_express_sessions" name="Turnos y Arqueos" parent="menu_pos_express_root" action="action_pos_express_session" sequence="20"/>
    <menuitem id="menu_pos_express_moves" name="Comprobantes" parent="menu_pos_express_root" action="action_pos_express_moves" sequence="30"/>
</odoo>
