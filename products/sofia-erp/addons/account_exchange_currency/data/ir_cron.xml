<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_exchange_rates" model="ir.cron">
            <field name="name">Sincronización Diaria Tipo de Cambio</field>
            <field name="model_id" ref="model_res_currency_rate"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_exchange_rates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        </record>
    </data>
</odoo>
