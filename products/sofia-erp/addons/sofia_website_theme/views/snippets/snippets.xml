                        <span class="sofia-pipeline-arrow">➔</span>
                        <span class="sofia-pipeline-step">📄 SUNAT &amp; GRE 09/31</span>
                        <span class="sofia-pipeline-arrow">➔</span>
                        <span class="sofia-pipeline-step">📦 Kardex Automático</span>
                        <span class="sofia-pipeline-arrow">➔</span>
                        <span class="sofia-pipeline-step">📊 Asiento &amp; SIRE</span>
                    </div>

                    <!-- Cuadrícula Bento de 4 Pilares Operativos -->
                    <div class="row g-3 justify-content-center" style="max-width: 1240px; margin: 0 auto;">
                        
                        <!-- Pilar 1: Ventas y POS -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <a href="/aplicaciones/punto-de-venta" class="bento-card">
                                <div>
