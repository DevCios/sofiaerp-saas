    <!-- 3. Snippet: Pilares de Confianza -->
    <template id="s_sofia_features" name="Pilares de Valor">
        <section class="py-5 bg-light border-top border-bottom">
            <div class="container py-lg-4">
                <div class="row g-4 text-center">
                    <div class="col-lg-4">
                        <div class="p-4 bg-white rounded-3 border h-100">
                            <span class="fs-2 d-block mb-2">🇵🇪</span>
                            <h5 class="fw-bold mb-2">SUNAT UBL 2.1 Ilimitado</h5>
                            <p class="text-muted small mb-0">Facturación y Guías GRE sin costos adicionales por comprobante emitido.</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="p-4 bg-white rounded-3 border h-100">
                            <span class="fs-2 d-block mb-2">🛡️</span>
                            <h5 class="fw-bold mb-2">Base de Datos Dedicada</h5>
                            <p class="text-muted small mb-0">Aislamiento físico estricto por cliente. Tu información es exclusivamente tuya.</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="p-4 bg-white rounded-3 border h-100">
                            <span class="fs-2 d-block mb-2">☁️</span>
                            <h5 class="fw-bold mb-2">Respaldo Google Drive</h5>
                            <p class="text-muted small mb-0">Copia de seguridad diaria automatizada directo a tu cuenta de Google Drive.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- 4. Snippet: Llamada a la Acción (CTA) Final Estilo Odoo -->
    <template id="s_sofia_cta" name="Llamada a la Acción">
        <section class="py-5 bg-white text-center">
            <div class="container py-lg-5">
                <h2 class="display-6 fw-bold mb-3">Únete a las empresas que crecen con SOFIA ERP</h2>
                <p class="lead text-muted mb-4 mx-auto" style="max-width: 600px;">
                    Comienza hoy mismo con tu periodo de prueba gratis. Sin contratos forzosos.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/precios" class="odoo-btn-primary">
                        Comienza ahora, es gratis
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
