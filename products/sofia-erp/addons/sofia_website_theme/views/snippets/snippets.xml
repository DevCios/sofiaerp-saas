                    <a href="/precios" class="sofia-btn-primary">
                        Empieza gratis
                    </a>
                    <a href="/soporte" class="sofia-btn-secondary">
                        Habla con un asesor
                    </a>
                </div>

                <!-- Barra de Beneficios de Confianza -->
