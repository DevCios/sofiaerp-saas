                <!-- Script Interactivo del Switch Anual / Mensual -->
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function () {
                        var switchContainer = document.getElementById('odooBillingSwitch');
                        if (!switchContainer) return;
                        
                        var optAnual = document.getElementById('btnOptAnual');
                        var optMensual = document.getElementById('btnOptMensual');
                        var isMonthly = false;

                        function updatePricing(monthly) {
                            isMonthly = monthly;
                            if (isMonthly) {
                                switchContainer.classList.add('monthly');
                                if (optMensual) optMensual.classList.add('active');
                                if (optAnual) optAnual.classList.remove('active');
                                
                                var emp = document.querySelector('.price-val-emprendedor');
                                if (emp) emp.textContent = '11.90';
                                var pym = document.querySelector('.price-val-pyme');
                                if (pym) pym.textContent = '16.90';
                                var crp = document.querySelector('.price-val-corp');
                                if (crp) crp.textContent = '21.90';
                                
                                document.querySelectorAll('.price-strikethrough').forEach(function(el) {
                                    el.style.display = 'none';
                                });
                                document.querySelectorAll('.billing-cycle-note').forEach(function(el) {
                                    el.textContent = 'Facturado mensualmente';
                                });
                            } else {
                                switchContainer.classList.remove('monthly');
                                if (optAnual) optAnual.classList.add('active');
                                if (optMensual) optMensual.classList.remove('active');
                                
                                var emp = document.querySelector('.price-val-emprendedor');
                                if (emp) emp.textContent = '9.90';
                                var pym = document.querySelector('.price-val-pyme');
                                if (pym) pym.textContent = '14.90';
                                var crp = document.querySelector('.price-val-corp');
                                if (crp) crp.textContent = '19.90';
                                
                                document.querySelectorAll('.price-strikethrough').forEach(function(el) {
                                    el.style.display = 'inline-block';
                                });
                                document.querySelectorAll('.billing-cycle-note').forEach(function(el) {
                                    el.textContent = 'Facturado anualmente';
                                });
                            }
                        }

                        switchContainer.addEventListener('click', function () {
                            updatePricing(!isMonthly);
                        });
                        if (optAnual) {
                            optAnual.addEventListener('click', function (e) {
                                e.stopPropagation();
                                updatePricing(false);
                            });
                        }
                        if (optMensual) {
                            optMensual.addEventListener('click', function (e) {
                                e.stopPropagation();
                                updatePricing(true);
                            });
                        }
                    });
                </script>
            </div>
        </t>
    </template>

    <record id="pricing_website_page" model="website.page">
        <field name="name">Precios y Planes</field>
        <field name="url">/precios</field>
        <field name="view_id" ref="pricing_page"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>
</odoo>
