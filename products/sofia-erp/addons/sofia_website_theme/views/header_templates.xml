                                            <ul class="odoo-links-list">
                                                <li><a href="/aplicaciones/ventas">CRM de Clientes</a></li>
                                                <li><a href="/aplicaciones/ventas">Ventas &amp; Cotizaciones</a></li>
                                                <li><a href="/precios">Suscripciones Recurrentes</a></li>
                                                <li><a href="/aplicaciones/punto-de-venta">PdV para Tiendas y Mostrador</a></li>
                                                <li><a href="/verticales/restaurante">PdV para Restaurantes</a></li>
                                            </ul>
                                        </div>

                                        <!-- Cadena de Suministro -->
                                        <div class="odoo-col-group">
                                            <div class="odoo-category-header color-alimentos">Cadena de Suministro</div>
                                            <ul class="odoo-links-list">
                                                <li><a href="/aplicaciones/inventario">Inventario &amp; Kardex Valorizado</a></li>
                                                <li><a href="/verticales/industria">Manufactura &amp; Producción</a></li>
                                                <li><a href="/aplicaciones/guias-remision">Guías de Remisión GRE 09/31</a></li>
                                                <li><a href="/aplicaciones/compras">Compras &amp; Gastos</a></li>
