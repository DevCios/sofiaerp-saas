                                        <!-- Servicios & RRHH -->
                                        <div class="odoo-col-group">
                                            <div class="odoo-category-header color-servicios">Servicios &amp; RRHH</div>
                                            <ul class="odoo-links-list">
                                                <li><a href="/verticales/servicios">Gestión de Proyectos</a></li>
