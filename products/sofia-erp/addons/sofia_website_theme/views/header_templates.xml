                            </div>
                        </li>

                        <!-- 2. Mega-Menú: Verticales (11 Sectores Exactos Estilo Odoo.com) -->
                        <li class="odoo-nav-item odoo-dropdown" id="menu-verticales">
                            <a class="odoo-nav-link" href="#">
                                <span>Verticales</span>
                                <span class="odoo-caret"></span>
                            </a>
                            <div class="odoo-megamenu-panel">
                                <div class="odoo-mega-container">
