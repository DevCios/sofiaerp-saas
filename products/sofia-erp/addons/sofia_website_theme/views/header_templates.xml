                            <div class="odoo-megamenu-panel">
                                <div class="odoo-mega-container">
                                    <div class="odoo-mega-grid">
                                        <!-- Finanzas -->
                                        <div class="odoo-col-group">
                                            <div class="odoo-category-header color-finanzas">Finanzas</div>
                                            <ul class="odoo-links-list">
                                                <li><a href="/aplicaciones/facturacion-electronica">Facturación SUNAT UBL 2.1</a></li>
                                                <li><a href="/verticales/contabilidad">Contabilidad &amp; SIRE</a></li>
