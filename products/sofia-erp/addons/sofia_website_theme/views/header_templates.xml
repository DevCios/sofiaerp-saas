                </div>

                <!-- Script Blindado con Tolerancia Hover Extendida (400ms) y Bloqueo por Clic -->
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function () {
                        const dropdowns = document.querySelectorAll('.odoo-dropdown');
                        let globalHideTimer = null;

                        function closeAllMenus() {
                            dropdowns.forEach(function (d) {
                                d.classList.remove('is-active');
                                const p = d.querySelector('.odoo-megamenu-panel');
                                if (p) p.classList.remove('is-open');
                            });
                        }

                        dropdowns.forEach(function (dd) {
                            const link = dd.querySelector('.odoo-nav-link');
                            const panel = dd.querySelector('.odoo-megamenu-panel');

                            function openThisMenu() {
                                clearTimeout(globalHideTimer);
                                dropdowns.forEach(function (other) {
                                    if (other !== dd) {
                                        other.classList.remove('is-active');
                                        const op = other.querySelector('.odoo-megamenu-panel');
                                        if (op) op.classList.remove('is-open');
                                    }
                                });
                                dd.classList.add('is-active');
                                if (panel) panel.classList.add('is-open');
                            }

                            function scheduleClose() {
                                clearTimeout(globalHideTimer);
                                globalHideTimer = setTimeout(function () {
                                    dd.classList.remove('is-active');
                                    if (panel) panel.classList.remove('is-open');
                                }, 400); // 400ms de tolerancia garantizada
                            }

                            // Eventos de ratón en el nav-item
                            dd.addEventListener('mouseenter', openThisMenu);
                            dd.addEventListener('mouseleave', scheduleClose);

                            // Eventos directos en el panel para cancelar cierre
                            if (panel) {
                                panel.addEventListener('mouseenter', function () {
                                    clearTimeout(globalHideTimer);
                                    dd.classList.add('is-active');
                                    panel.classList.add('is-open');
                                });
                                panel.addEventListener('mouseleave', scheduleClose);
                            }

                            // Clic para fijar / alternar el menú
                            if (link) {
                                link.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    const wasActive = dd.classList.contains('is-active');
                                    closeAllMenus();
                                    if (!wasActive) {
                                        dd.classList.add('is-active');
                                        if (panel) panel.classList.add('is-open');
                                    }
                                });
                            }
                        });

                        // Cerrar al hacer clic en enlaces no dropdown (Comunidad, Precios, Ayuda) o fuera
                        document.querySelectorAll('.odoo-nav-item:not(.odoo-dropdown) a').forEach(function(l) {
                            l.addEventListener('mouseenter', closeAllMenus);
                        });

                        document.addEventListener('click', function (e) {
                            if (!e.target.closest('.odoo-dropdown')) {
                                closeAllMenus();
                            }
                        });
                    });
                </script>
