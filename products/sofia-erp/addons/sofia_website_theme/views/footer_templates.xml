<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pie de Página (Footer) Estilo Mercado Libre Perú & Ecosistema E-Commerce -->
    <template id="sofia_footer" inherit_id="website.layout" name="SOFIA ERP / Mercado Wanka Footer Estilo Mercado Libre">
        <xpath expr="//footer" position="replace">
            <footer id="bottom" data-anchor="true" class="sofia-meli-footer">
                
                <style>
                    .sofia-meli-footer {
                        background-color: #F8F9FA !important;
                        border-top: 1px solid #E5E7EB !important;
                        color: #475569 !important;
                        padding-top: 2.5rem !important;
                        padding-bottom: 2rem !important;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
                    }
                    .sofia-meli-footer .trust-card {
                        background: #FFFFFF;
                        border: 1px solid #E5E7EB;
                        border-radius: 12px;
                        padding: 1.5rem 1.25rem;
                        transition: transform 0.2s ease, box-shadow 0.2s ease;
                        height: 100%;
                    }
                    .sofia-meli-footer .trust-card:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
                    }
                    .sofia-meli-footer .reclamaciones-banner {
                        background: #FFFFFF;
                        border: 1px solid #E2E8F0;
                        border-radius: 12px;
                        padding: 1.25rem 2rem;
                        margin-bottom: 2.5rem;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        flex-wrap: wrap;
                        gap: 1.25rem;
                        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
                    }
                    .sofia-meli-footer .btn-meli-cyan {
                        background-color: #009EE3 !important;
                        color: #FFFFFF !important;
                        font-weight: 700 !important;
                        padding: 0.65rem 2.25rem !important;
                        border-radius: 8px !important;
                        text-decoration: none !important;
                        font-size: 0.95rem !important;
                        display: inline-block !important;
                        transition: background-color 0.2s ease, transform 0.15s ease !important;
                        border: none !important;
                    }
                    .sofia-meli-footer .btn-meli-cyan:hover {
                        background-color: #0081BA !important;
                        color: #FFFFFF !important;
                        transform: translateY(-1px);
                    }
                    .sofia-meli-footer h6 {
                        color: #1E293B !important;
                        font-size: 0.88rem !important;
                        font-weight: 700 !important;
                        margin-bottom: 1rem !important;
                    }
                    .sofia-meli-footer ul.footer-col-links {
                        list-style: none !important;
                        padding-left: 0 !important;
                        margin-left: 0 !important;
                        margin-bottom: 0 !important;
                    }
                    .sofia-meli-footer ul.footer-col-links li {
                        margin-bottom: 0.5rem !important;
                    }
                    .sofia-meli-footer ul.footer-col-links a {
                        color: #64748B !important;
                        text-decoration: none !important;
                        font-size: 0.84rem !important;
                        transition: color 0.15s ease !important;
                    }
                    .sofia-meli-footer ul.footer-col-links a:hover {
                        color: #009EE3 !important;
                        text-decoration: underline !important;
                    }
                    .sofia-meli-footer .social-circle-btn {
                        width: 34px;
                        height: 34px;
                        border-radius: 50%;
                        background: #E2E8F0;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        color: #334155;
                        text-decoration: none;
                        transition: all 0.2s ease;
                        font-size: 0.9rem;
                    }
                    .sofia-meli-footer .social-circle-btn:hover {
                        background: #009EE3;
                        color: #FFFFFF;
                        transform: translateY(-2px);
                    }
                    .sofia-meli-footer .legal-links-row a {
                        color: #475569;
                        text-decoration: none;
                        font-size: 0.8rem;
                        transition: color 0.15s;
                    }
                    .sofia-meli-footer .legal-links-row a:hover {
                        color: #009EE3;
                        text-decoration: underline;
                    }
                </style>

                <div class="container px-lg-4">
                    
                    <!-- 1. BANNER DESTACADO: LIBRO DE RECLAMACIONES DIGITAL (Idéntico a Mercado Libre) -->
                    <div class="reclamaciones-banner">
                        <div class="d-flex align-items-center gap-3">
                            <div style="font-size: 2.4rem; color: #2563EB; flex-shrink: 0;">
                                <i class="fa fa-book"></i>
                            </div>
                            <div>
                                <span class="d-block fw-bold text-dark" style="font-size: 1.15rem; letter-spacing: -0.01em;">
                                    Ponemos a tu disposición el Libro de Reclamaciones digital
                                </span>
                                <span class="d-block text-muted small" style="font-size: 0.82rem;">
                                    Conforme a lo establecido en el Código de Protección y Defensa del Consumidor (Ley N° 29571) • Indecopi Perú
                                </span>
                            </div>
                        </div>
                        <div>
                            <a href="/libro-de-reclamaciones" class="btn-meli-cyan shadow-sm">
                                Ingresar
                            </a>
                        </div>
                    </div>

                    <!-- 3. COLUMNAS DE NAVEGACIÓN PROFESIONALES -->
                    <div class="row g-4 mb-4">
                        <!-- Columna 1: Acerca de -->
                        <div class="col-6 col-md-2">
                            <h6>SOFIA ERP</h6>
                            <ul class="footer-col-links">
                                <li><a href="/">Inicio</a></li>
                                <li><a href="/precios">Planes y Precios</a></li>
                                <li><a href="/verticales">Verticales de Negocio</a></li>
                                <li><a href="/terminos">Términos del servicio</a></li>
                                <li><a href="/privacidad">Política de privacidad</a></li>
                            </ul>
                        </div>

                        <!-- Columna 2: Mi cuenta -->
                        <div class="col-6 col-md-2">
                            <h6>Plataforma</h6>
                            <ul class="footer-col-links">
                                <li><a href="/login">Iniciar sesión</a></li>
                                <li><a href="/precios">Crear cuenta ERP</a></li>
                                <li><a href="/soporte">Centro de ayuda</a></li>
                                <li><a href="/libro-de-reclamaciones">Libro de Reclamaciones</a></li>
                                <li><a href="https://api.sofiaerp.com/admin" target="_blank" rel="noopener">Admin Portal</a></li>
                            </ul>
                        </div>

                        <!-- Columna 3: Ecosistema -->
                        <div class="col-6 col-md-2">
                            <h6>Ecosistema</h6>
                            <ul class="footer-col-links">
                                <li><a href="https://apisunat.pro" target="_blank" rel="noopener">API SUNAT (Facturación)</a></li>
                                <li><a href="https://docs.apisunat.pro" target="_blank" rel="noopener">Documentación API &amp; MCP</a></li>
                                <li><a href="https://tienda.sofiaerp.com" target="_blank" rel="noopener">Mercado Wanka</a></li>
                                <li><a href="https://tienda.sofiaerp.com/vende-con-nosotros" target="_blank" rel="noopener">Vende en Mercado Wanka</a></li>
                            </ul>
                        </div>

                        <!-- Columna 4: Verticales -->
                        <div class="col-6 col-md-3">
                            <h6>Soluciones Perú</h6>
                            <ul class="footer-col-links">
                                <li><a href="/verticales/bodegas">POS para Bodegas</a></li>
                                <li><a href="/verticales/ferreterias">Ferreterías y Retail</a></li>
                                <li><a href="/verticales/restaurante">Restaurantes y Cafés</a></li>
                                <li><a href="/verticales/contabilidad">Contabilidad &amp; SIRE SUNAT</a></li>
                                <li><a href="/verticales/manufactura">Manufactura y Costos</a></li>
                            </ul>
                        </div>

                        <!-- Columna 5: Contacto & Redes -->
                        <div class="col-12 col-md-3">
                            <h6>Contáctanos</h6>
                            <div class="small text-muted mb-2">
                                <t t-if="res_company.email">
                                    <div class="mb-1">
                                        <i class="fa fa-envelope me-2 text-primary"></i>
                                        <span t-field="res_company.email"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="mb-1">
                                        <i class="fa fa-envelope me-2 text-primary"></i>
                                        soporte@sofiaerp.com
                                    </div>
                                </t>
                                <t t-if="res_company.phone">
                                    <div class="mb-2">
                                        <i class="fa fa-phone me-2 text-success"></i>
                                        <span t-field="res_company.phone"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="mb-2">
                                        <i class="fa fa-phone me-2 text-success"></i>
                                        Perú • Atención Nacional
                                    </div>
                                </t>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <a href="/soporte" class="social-circle-btn" aria-label="Soporte Técnico">
                                    <i class="fa fa-headphones"></i>
                                </a>
                                <a href="mailto:soporte@sofiaerp.com" class="social-circle-btn" aria-label="Correo">
                                    <i class="fa fa-envelope"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- 4. LÍNEA LEGAL -->
                    <div class="border-top pt-3 mt-4" style="border-color: #E2E8F0 !important; font-size: 0.78rem; color: #64748B;">
                        <div class="legal-links-row d-flex flex-wrap gap-2 gap-md-3 mb-2">
                            <a href="/terminos">Términos del servicio</a>
                            <span class="text-muted">·</span>
                            <a href="/privacidad">Política de privacidad (Ley 29733)</a>
                            <span class="text-muted">·</span>
                            <a href="/libro-de-reclamaciones">Libro de Reclamaciones</a>
                            <span class="text-muted">·</span>
                            <a href="/soporte">Centro de ayuda</a>
                        </div>
                        
                        <div class="mb-1 text-muted">
                            Copyright © 2026 <t t-out="res_company.name or 'SOFIA ERP S.A.C.'"/>. Todos los derechos reservados.
                        </div>

                        <div class="text-muted small" style="font-size: 0.73rem;">
                            Razón Social: <t t-out="res_company.name or 'SOFIA ERP S.A.C.'"/> • 
                            RUC: <t t-out="res_company.vat or '20600000000'"/> • 
                            <t t-if="res_company.street"><t t-out="res_company.street"/>, </t>
                            <t t-if="res_company.city"><t t-out="res_company.city"/>, </t>
                            Perú.
                        </div>
                    </div>

                </div>
            </footer>
        </xpath>
    </template>
</odoo>
