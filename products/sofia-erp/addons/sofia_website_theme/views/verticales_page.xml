        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Retail</h5>
                                            <p class="text-secondary small mb-0">Variantes de talla y color, temporadas, promociones automáticas y etiquetas térmicas.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Boticas -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/boticas" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
                                                <rect x="17" y="7" width="10" height="30" rx="3" fill="#10B981"/>
                                                <rect x="7" y="17" width="30" height="10" rx="3" fill="#10B981"/>
                                                <path d="M22 17H27C29.2 17 31 18.8 31 21V23C31 25.2 29.2 27 27 27H22V17Z" fill="#0EA5E9"/>
                                                <circle cx="22" cy="22" r="4.5" fill="#FFFFFF"/>
                                                <path d="M22 19.5V24.5M19.5 22H24.5" stroke="#10B981" stroke-width="2" stroke-linecap="round"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Boticas</h5>
                                            <p class="text-secondary small mb-0">Venta fraccionada por pastillas, control de lotes y fechas de vencimiento, DIGEMID y boletas rápidas.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Manufactura -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/manufactura" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <path d="M8 22L15 17V34H8V22Z" fill="#06B6D4"/>
            <path d="M15 17L23 11V34H15V17Z" fill="#0D9488"/>
            <path d="M23 20L30 15V34H23V20Z" fill="#E55A5A"/>
            <path d="M30 16L36 12V34H30V16Z" fill="#FBBF24"/>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Manufactura</h5>
                                            <p class="text-secondary small mb-0">Listas de materiales (BOM), órdenes de producción, control de mermas y costeo real.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Odontología -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/odontologia" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <path d="M14 6C10 6 8 10 8 15C8 22 11 27 13 35C14 39 17 39 18 35C19 31 20 25 22 25C24 25 25 31 26 35C27 39 30 39 31 35C33 27 36 22 36 15C36 10 34 6 30 6C26 6 23 8 22 10C21 8 18 6 14 6Z" fill="#0EA5E9"/>
            <circle cx="22" cy="18" r="6" fill="#0D9488"/>
            <path d="M22 14V22M18 18H26" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Odontología</h5>
                                            <p class="text-secondary small mb-0">Historias clínicas odontológicas, agenda médica de citas, boletas y control de insumos.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Servicios -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/servicios" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <path d="M12 24C12 16 17 11 25 11C28 11 31 12 33 14L22 25L12 24Z" fill="#F97316"/>
            <path d="M25 11C33 11 38 16 38 24L22 25L25 11Z" fill="#0284C7"/>
            <path d="M22 25L13 34" stroke="#7D1A6A" stroke-width="3" stroke-linecap="round"/>
            <path d="M13 34C11.5 35.5 10 34 10 34" stroke="#7D1A6A" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Servicios</h5>
                                            <p class="text-secondary small mb-0">Facturación recurrente mensual, seguimiento de hitos, partes de horas y contratos.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Restaurante -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/restaurante" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <circle cx="22" cy="22" r="14" fill="#FEE2E2"/>
            <circle cx="22" cy="22" r="10" stroke="#E55A5A" stroke-width="2.5" fill="#FFFFFF"/>
            <path d="M17 16V27M15 16V20M19 16V20" stroke="#7D1A6A" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M27 16V27M27 16C28.5 16 29 17.5 29 19.5C29 21.5 28 22 27 22" stroke="#F97316" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Restaurante</h5>
                                            <p class="text-secondary small mb-0">Comandera para cocina y barra, gestión gráfica de mesas, recetas y división de cuentas.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Comercio electrónico -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/comercio-electronico" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <path d="M10 20C10 13.3726 15.3726 8 22 8C28.6274 8 34 13.3726 34 20C28 22 24 16 18 18C14 19 12 21 10 20Z" fill="#0D9488"/>
            <path d="M34 24C34 30.6274 28.6274 36 22 36C15.3726 36 10 30.6274 10 24C16 22 20 28 26 26C30 25 32 23 34 24Z" fill="#0284C7"/>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Comercio electrónico</h5>
                                            <p class="text-secondary small mb-0">Tienda web sincronizada en vivo con inventario, pasarela Mercado Pago y SUNAT.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Gestión de flotas -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/gestion-de-flotas" class="vert-card text-dark">
