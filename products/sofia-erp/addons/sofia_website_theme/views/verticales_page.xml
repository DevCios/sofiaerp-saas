                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <circle cx="22" cy="22" r="14" stroke="#7D1A6A" stroke-width="4.5"/>
            <circle cx="22" cy="22" r="5" fill="#7D1A6A"/>
            <path d="M22 13V17M13 22H17M27 22H31M15.5 28.5L18.5 25.5M28.5 28.5L25.5 25.5" stroke="#7D1A6A" stroke-width="3" stroke-linecap="round"/>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Gestión de flotas</h5>
                                            <p class="text-secondary small mb-0">Control de kilometraje, choferes, mantenimientos mecánicos y Guías GRE transportista.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>

                            <!-- Recursos humanos -->
                            <div class="col-lg-4 col-md-6">
                                <a href="/verticales/recursos-humanos" class="vert-card text-dark">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="vert-squircle-icon">
                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <circle cx="22" cy="14" r="3.5" fill="#7D1A6A"/>
            <circle cx="14" cy="17" r="3" fill="#E55A5A"/>
            <circle cx="30" cy="17" r="3" fill="#0D9488"/>
            <path d="M17 23C17 21 19 19.5 22 19.5C25 19.5 27 21 27 23V27H17V23Z" fill="#7D1A6A"/>
            <path d="M9 26C9 24.5 11 23 14 23V27H9V26Z" fill="#E55A5A"/>
            <path d="M35 26C35 24.5 33 23 30 23V27H35V26Z" fill="#0D9488"/>
            <rect x="9" y="27" width="26" height="4" rx="2" fill="#FBBF24"/>
        </svg>
                                        </div>
                                        <div>
