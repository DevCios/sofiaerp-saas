                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <path d="M10 8C10 5.79086 11.7909 4 14 4H26L34 12V36C34 38.2091 32.2091 40 30 40H14C11.7909 40 10 38.2091 10 36V8Z" fill="#0EA5E9"/>
            <path d="M26 4V12H34L26 4Z" fill="#0284C7"/>
            <path d="M10 34C10 34 16 32 22 34C28 36 34 34 34 34V37C34 38.6569 32.6569 40 31 40H13C11.3431 40 10 38.6569 10 37V34Z" fill="#0369A1"/>
            <text x="22" y="27" font-family="'Inter', sans-serif" font-size="14" font-weight="900" fill="#FFFFFF" text-anchor="middle">$</text>
        </svg>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">Contabilidad</h5>
                                            <p class="text-secondary small mb-0">Plan Contable General Empresarial (PCGE), conciliación bancaria y libros SIRE SUNAT.</p>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-end">
                                        <span class="vert-action-link">Ver vertical →</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA Final -->
                <section class="py-5 bg-white text-center border-top">
                    <div class="container py-lg-4">
                        <h2 class="display-6 fw-bold mb-3">¿Tu rubro tiene requerimientos específicos?</h2>
                        <p class="lead text-muted mb-4 mx-auto" style="max-width: 650px;">
                            Nuestros consultores adaptan los flujos de SOFIA ERP a los procesos exactos de tu organización.
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="/soporte" class="odoo-btn-primary">
                                Hablar con un Asesor Especializado
                            </a>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

