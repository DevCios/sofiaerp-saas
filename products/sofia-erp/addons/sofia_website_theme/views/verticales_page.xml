                                            <svg width="38" height="38" viewBox="0 0 44 44" fill="none">
            <path d="M12 8H22L34 20C35.5 21.5 35.5 24 34 25.5L25.5 34C24 35.5 21.5 35.5 20 34L8 22V12C8 9.8 9.8 8 12 8Z" fill="#E55A5A"/>
            <path d="M12 8H20L10 18V10C10 8.9 10.9 8 12 8Z" fill="#7D1A6A"/>
