<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_currency_rate_range_wizard_form" model="ir.ui.view">
        <field name="name">currency.rate.range.wizard.form</field>
        <field name="model">currency.rate.range.wizard</field>
        <field name="arch" type="xml">
            <form string="Histórico de tipo de cambio SUNAT">
                <sheet>
                    <group>
                        <group>
                            <field name="currency_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Se consultará el tipo de cambio SUNAT (USD) entre las fechas indicadas
                        y se crearán/actualizarán las tasas en Odoo para cada día del rango,
                        incluyendo fines de semana (con el último valor hábil reportado por Migo).
                        Las fechas futuras no están permitidas.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" string="Aplicar" type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_currency_rate_range_wizard" model="ir.actions.act_window">
        <field name="name">Histórico de tipo de cambio</field>
        <field name="res_model">currency.rate.range.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_currency_id': active_id}</field>
    </record>

</odoo>
