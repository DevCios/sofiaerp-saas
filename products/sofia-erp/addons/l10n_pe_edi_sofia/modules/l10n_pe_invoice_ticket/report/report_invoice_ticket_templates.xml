<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_ticket_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="extra_vals" t-value="o._l10n_pe_edi_get_extra_report_values() if hasattr(o, '_l10n_pe_edi_get_extra_report_values') else {}"/>
            <t t-set="spot" t-value="o._l10n_pe_edi_get_spot() if hasattr(o, '_l10n_pe_edi_get_spot') else False"/>

            <div class="page" style="font-family: 'Courier New', monospace; font-size: 10px; line-height: 1.2; width: 72mm; margin: 0 auto; color: #000;">
                <!-- Header Empresa -->
                <div class="text-center" style="margin-bottom: 8px;">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 45px; max-width: 65mm; margin-bottom: 4px;" alt="Logo"/>
                    <div style="font-size: 12px; font-weight: bold;"><t t-out="o.company_id.name"/></div>
                    <div>RUC: <t t-out="o.company_id.vat"/></div>
                    <div t-if="o.company_id.street"><t t-out="o.company_id.street"/></div>
                    <div t-if="o.company_id.phone">Telf: <t t-out="o.company_id.phone"/></div>
                    <div t-if="o.company_id.email"><t t-out="o.company_id.email"/></div>
                </div>

                <div style="border-top: 1px dashed #000; margin: 4px 0;"/>

                <!-- Datos Comprobante -->
                <div class="text-center" style="font-size: 11px; font-weight: bold; margin: 6px 0;">
                    <div><t t-out="(o.l10n_latam_document_type_id.name or 'COMPROBANTE ELECTRÃ“NICO').upper()"/></div>
                    <div><t t-out="o.name"/></div>
                </div>

                <div style="border-top: 1px dashed #000; margin: 4px 0;"/>

                <!-- Datos Cliente -->
                <div style="margin-bottom: 6px;">
                    <div><b>Fecha EmisiÃ³n:</b> <t t-out="o.invoice_date"/></div>
                    <div t-if="o.invoice_date_due"><b>Fecha Venc.:</b> <t t-out="o.invoice_date_due"/></div>
                    <div><b>Cliente:</b> <t t-out="o.partner_id.name"/></div>
                    <div><b><t t-out="o.partner_id.l10n_latam_identification_type_id.name or 'DOC'"/>:</b> <t t-out="o.partner_id.vat or '-'"/></div>
                    <div t-if="o.partner_id.street"><b>DirecciÃ³n:</b> <t t-out="o.partner_id.street"/></div>
                    <div><b>Moneda:</b> <t t-out="o.currency_id.currency_unit_label or o.currency_id.name"/></div>
                    <div t-if="o.invoice_payment_term_id"><b>CondiciÃ³n:</b> <t t-out="o.invoice_payment_term_id.name"/></div>
                </div>

                <div style="border-top: 1px dashed #000; margin: 4px 0;"/>

                <!-- Tabla de Productos -->
                <table style="width: 100%; border-collapse: collapse; font-size: 9px; margin-bottom: 6px;">
                    <thead>
                        <tr style="border-bottom: 1px solid #000;">
                            <th style="text-align: left; width: 15%;">Cant</th>
                            <th style="text-align: left; width: 50%;">Desc.</th>
                            <th style="text-align: right; width: 15%;">P.U.</th>
                            <th style="text-align: right; width: 20%;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                            <td style="vertical-align: top;"><t t-out="line.quantity"/></td>
                            <td style="vertical-align: top;"><t t-out="line.name"/></td>
                            <td style="text-align: right; vertical-align: top;"><t t-out="f'{line.price_unit:.2f}'"/></td>
                            <td style="text-align: right; vertical-align: top;"><t t-out="f'{line.price_total:.2f}'"/></td>
                        </tr>
                    </tbody>
                </table>

                <div style="border-top: 1px dashed #000; margin: 4px 0;"/>

                <!-- Totales -->
                <div style="margin-left: auto; width: 100%; font-size: 10px;">
                    <t t-set="tax_data" t-value="o._l10n_pe_sire_get_tax_breakdown() if hasattr(o, '_l10n_pe_sire_get_tax_breakdown') else {}"/>
                    <table style="width: 100%;">
                        <tr t-if="tax_data.get('gravado')">
                            <td>Op. Gravada:</td>
                            <td style="text-align: right;"><t t-out="f'{tax_data.get(\'gravado\', 0):.2f}'"/></td>
                        </tr>
                        <tr t-if="tax_data.get('exonerado')">
                            <td>Op. Exonerada:</td>
                            <td style="text-align: right;"><t t-out="f'{tax_data.get(\'exonerado\', 0):.2f}'"/></td>
                        </tr>
                        <tr t-if="tax_data.get('inafecto')">
                            <td>Op. Inafecta:</td>
                            <td style="text-align: right;"><t t-out="f'{tax_data.get(\'inafecto\', 0):.2f}'"/></td>
                        </tr>
                        <tr>
                            <td>IGV (18%):</td>
                            <td style="text-align: right;"><t t-out="f'{tax_data.get(\'igv\', 0) if tax_data else o.amount_tax:.2f}'"/></td>
                        </tr>
                        <tr t-if="tax_data.get('icbper')">
                            <td>ICBPER:</td>
                            <td style="text-align: right;"><t t-out="f'{tax_data.get(\'icbper\', 0):.2f}'"/></td>
                        </tr>
                        <tr style="font-weight: bold; font-size: 11px; border-top: 1px solid #000;">
                            <td>TOTAL A PAGAR:</td>
                            <td style="text-align: right;"><t t-out="f'{o.currency_id.symbol} {o.amount_total:.2f}'"/></td>
                        </tr>
                    </table>
                </div>

                <div style="border-top: 1px dashed #000; margin: 4px 0;"/>

                <!-- Monto en Letras -->
                <div style="font-size: 9px; margin-bottom: 6px;">
                    <b>SON:</b> <t t-out="extra_vals.get('amount_to_text') or o.currency_id.amount_to_text(o.amount_total)"/>
                </div>

                <!-- Detracciones (SPOT) -->
                <div t-if="spot" style="border: 1px dashed #000; padding: 4px; margin-bottom: 6px; font-size: 9px;">
                    <div style="font-weight: bold; text-align: center;">OPERACIÃ“N SUJETA AL SPOT</div>
                    <div><b>Cta. Banco NaciÃ³n:</b> <t t-out="spot.get('payee_financial_account')"/></div>
                    <div><b>Porcentaje:</b> <t t-out="spot.get('payment_percent')"/>%</div>
                    <div><b>Monto DetracciÃ³n:</b> S/ <t t-out="f'{spot.get(\'amount\', 0):.2f}'"/></div>
                </div>

                <!-- QR y Hash -->
                <div class="text-center" style="margin-top: 8px;">
                    <t t-set="qr_string" t-value="extra_vals.get('qr_str') or f'{o.company_id.vat}|{o.l10n_latam_document_type_id.code}|{o.name}|{o.amount_tax}|{o.amount_total}|{o.invoice_date}|{o.partner_id.vat}'"/>
                    <img class="border border-dark rounded" t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=110&amp;height=110' % qr_string" style="width: 100px; height: 100px;" alt="QR SUNAT"/>
                    <div t-if="extra_vals.get('digest_value')" style="font-size: 8px; margin-top: 4px; word-break: break-all;">
                        <b>Hash:</b> <t t-out="extra_vals.get('digest_value')"/>
                    </div>
                </div>

                <div style="border-top: 1px dashed #000; margin: 6px 0;"/>

                <div class="text-center" style="font-size: 8px;">
                    <div>RepresentaciÃ³n impresa del Comprobante de Pago ElectrÃ³nico</div>
                    <div>Â¡Gracias por su compra!</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_invoice_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="l10n_pe_edi_sofia.report_invoice_ticket_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
