<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_transport_detraccion" model="ir.ui.view">
        <field name="name">account.move.form.inherit.transport.detraccion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='l10n_pe_edi']" position="inside">
                <group string="Detracción de Transporte de Carga (Operación 1004)"
                       invisible="l10n_pe_edi_operation_type != '1004'">
                    <group string="Ruta y Puntos del Traslado">
                        <field name="l10n_pe_edi_transport_origin_ubigeo" placeholder="Ej. 150101 (6 dígitos)" readonly="state != 'draft'"/>
                        <field name="l10n_pe_edi_transport_origin_address" placeholder="Dirección completa de partida" readonly="state != 'draft'"/>
                        <field name="l10n_pe_edi_transport_dest_ubigeo" placeholder="Ej. 040101 (6 dígitos)" readonly="state != 'draft'"/>
                        <field name="l10n_pe_edi_transport_dest_address" placeholder="Dirección completa de llegada" readonly="state != 'draft'"/>
                        <field name="l10n_pe_edi_transport_trip_detail" placeholder="Ej. Traslado de carga Lima - Arequipa" readonly="state != 'draft'"/>
                    </group>
                    <group string="Valores Referenciales MTC (D.S. 010-2006-MTC)">
                        <field name="l10n_pe_edi_transport_ref_value" readonly="state != 'draft'"/>
                        <field name="l10n_pe_edi_transport_ref_effective" readonly="state != 'draft'"/>
                        <field name="l10n_pe_edi_transport_ref_nominal" readonly="state != 'draft'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
