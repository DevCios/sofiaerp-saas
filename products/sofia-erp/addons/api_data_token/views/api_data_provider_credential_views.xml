<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="api_data_provider_credential_view_list" model="ir.ui.view">
        <field name="name">api.data.provider.credential.view.list</field>
        <field name="model">api.data.provider.credential</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="operation"/>
                <field name="provider"/>
                <field name="token" password="1" invisible="provider == 'apisnetpe_free'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="api_data_provider_credential_view_form" model="ir.ui.view">
        <field name="name">api.data.provider.credential.view.form</field>
        <field name="model">api.data.provider.credential</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="operation"/>
                        <field name="provider"/>
                        <field name="token" password="1" invisible="provider == 'apisnetpe_free'"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_data_provider_credential_action" model="ir.actions.act_window">
        <field name="name">Credenciales de API</field>
        <field name="res_model">api.data.provider.credential</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="api_data_provider_credential_menu"
        name="Credenciales de API"
        parent="base.menu_administration"
        action="api_data_provider_credential_action"        
        groups="base.group_no_one"
        sequence="30"/>
</odoo>
