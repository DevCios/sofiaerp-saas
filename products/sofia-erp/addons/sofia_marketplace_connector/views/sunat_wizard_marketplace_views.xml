<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sofia_sunat_setup_wizard_form_mercado_wanka" model="ir.ui.view">
        <field name="name">sofia.sunat.setup.wizard.form.mercado.wanka</field>
        <field name="model">sofia.sunat.setup.wizard</field>
        <field name="inherit_id" ref="l10n_pe_sunat.view_sofia_sunat_setup_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="5. Tienda Mercado Wanka">
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>Incluido con tu plan SOFIA ERP:</strong> Crea tu tienda oficial en
                        <strong>Mercado Wanka</strong> (<code>mercadowanka.com</code>) en 1 clic.
                        Publica tus productos directo desde tu inventario y emite tus boletas/facturas SUNAT desde tu ERP.
                        Comisión inicial: <strong>5% del valor total + S/ 0.50 por uso de plataforma</strong>
                        (Mercado Wanka solo factura la comisión; tú facturas tus productos al comprador).
                    </div>
                    <group>
                        <field name="enable_mercado_wanka" widget="boolean_toggle"/>
                        <field name="mw_store_name" invisible="not enable_mercado_wanka" placeholder="Mi Tienda Oficial"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
