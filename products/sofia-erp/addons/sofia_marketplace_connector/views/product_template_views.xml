<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_mercado_wanka" model="ir.ui.view">
        <field name="name">product.template.form.mercado.wanka</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_toggle_mercado_wanka_publish"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-bag">
                    <field name="mw_published" widget="boolean_button"
                           options="{'terminology': {'string_true': 'En Mercado Wanka', 'hover_true': 'Quitar de Mercado Wanka', 'string_false': 'Publicar en Wanka', 'hover_false': 'Publicar en Mercado Wanka'}}"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
