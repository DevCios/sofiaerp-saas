<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Top Level Menu -->
        <menuitem id="menu_wango_root"
                  name="WanGO Marketplace"
                  web_icon="wango_core,static/description/icon.png"
                  sequence="10"/>

        <!-- Categories -->
        <menuitem id="menu_wango_operations"
                  name="Operaciones"
                  parent="menu_wango_root"
                  sequence="10"/>

        <menuitem id="menu_wango_config"
                  name="Configuración"
                  parent="menu_wango_root"
                  sequence="100"/>

        <!-- Cities Action (preservada para módulos dependientes como Encomiendas, sin exponer en menú de Marketplace) -->
        <record id="action_wango_city" model="ir.actions.act_window">
            <field name="name">Ciudades</field>
            <field name="res_model">wango.city</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Agencies (Shalom, Marvisur, Olva Courier...) -->
        <record id="action_wango_agency" model="ir.actions.act_window">
            <field name="name">Agencias</field>
            <field name="res_model">wango.agency</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_wango_agency"
                  name="Agencias"
                  parent="menu_wango_config"
                  action="action_wango_agency"
                  sequence="30"/>
                  
        <!-- Menús de Vehículos y Conductores retirados (enfoque exclusivo en Marketplace y Encomiendas) -->
    </data>
</odoo>
