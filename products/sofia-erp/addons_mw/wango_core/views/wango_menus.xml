<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- App Raíz Única del Ecosistema Marketplace -->
        <menuitem id="menu_wango_root"
                  name="Mercado Wanka"
                  web_icon="wango_core,static/description/icon.png"
                  sequence="5"/>

        <!-- Logística y Envíos (sequence 50) -->
        <menuitem id="menu_wango_operations"
                  name="Logística y Envíos"
                  parent="menu_wango_root"
                  sequence="50"/>

        <!-- Configuración General y Tarifas (sequence 90) -->
        <menuitem id="menu_wango_config"
                  name="Configuración"
                  parent="menu_wango_root"
                  sequence="90"/>

        <!-- Cities Action (preservada para compatibilidad interna) -->
        <record id="action_wango_city" model="ir.actions.act_window">
            <field name="name">Ciudades</field>
            <field name="res_model">wango.city</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Agencias (Shalom, Marvisur, Olva Courier...) -->
        <record id="action_wango_agency" model="ir.actions.act_window">
            <field name="name">Agencias de Envío</field>
            <field name="res_model">wango.agency</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_wango_agency"
                  name="Agencias de Envío"
                  parent="menu_wango_config"
                  action="action_wango_agency"
                  sequence="30"/>
    </data>
</odoo>
