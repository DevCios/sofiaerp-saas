<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- City View -->
        <record id="view_wango_city_tree" model="ir.ui.view">
            <field name="name">wango.city.tree</field>
            <field name="model">wango.city</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="state_id"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_wango_city_form" model="ir.ui.view">
            <field name="name">wango.city.form</field>
            <field name="model">wango.city</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="state_id"/>
                                <field name="country_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vehicle View (Fleet Inheritance) -->
        <record id="view_wango_fleet_vehicle_tree" model="ir.ui.view">
            <field name="name">wango.fleet.vehicle.tree</field>
            <field name="model">fleet.vehicle</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <list>
                    <field name="license_plate"/>
                    <field name="model_id"/>
                    <field name="type_id"/>
                    <field name="wango_driver_id"/>
                    <field name="wango_status" widget="badge" decoration-success="wango_status == 'available'"/>
                    <field name="traccar_unique_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_wango_fleet_vehicle_form_inherit" model="ir.ui.view">
            <field name="name">wango.fleet.vehicle.form.inherit</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="wango_status" widget="statusbar" statusbar_visible="available,busy,maintenance"/>
                </xpath>
                <xpath expr="//sheet/group" position="after">
                    <notebook>
                        <page string="WanGO Capacidad">
                            <group>
                                <group string="Clasificación">
                                    <field name="type_id"/>
                                    <field name="capacity_passengers"/>
                                </group>
                                <group string="Carga (Encomiendas)">
                                    <field name="capacity_weight"/>
                                    <field name="capacity_volume"/>
                                </group>
                            </group>
                        </page>
                        <page string="WanGO Rastreo">
                            <group>
                                <field name="wango_driver_id" string="Conductor WanGO"/>
                                <field name="last_latitude"/>
                                <field name="last_longitude"/>
                                <field name="last_tracking_update"/>
                                <field name="traccar_unique_id"/>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        
        <!-- Driver View -->
        <record id="view_wango_driver_tree" model="ir.ui.view">
            <field name="name">wango.driver.tree</field>
            <field name="model">wango.driver</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="license_number"/>
                    <field name="status" widget="badge"/>
                    <field name="rating"/>
                    <field name="total_trips"/>
                </list>
            </field>
        </record>

        <record id="view_wango_driver_form" model="ir.ui.view">
            <field name="name">wango.driver.form</field>
            <field name="model">wango.driver</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="active,inactive,suspended"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="partner_id"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="license_number"/>
                                <field name="license_expiry"/>
                            </group>
                            <group>
                                <field name="rating"/>
                                <field name="total_trips"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Vehículos">
                                <field name="vehicle_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
