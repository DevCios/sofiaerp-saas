<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuración WanGO desactivada: No se requiere bloque en Ajustes generales de Odoo -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.wango_core</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
            </xpath>
        </field>
    </record>

    <record id="action_wango_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>
</odoo>

