<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_inherit_wango" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.wango</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <field name="wango_delivery_type"/>
                <field name="store_branch_id" invisible="wango_delivery_type != 'store_pickup'" required="wango_delivery_type == 'store_pickup'"/>
                <field name="agency_id" invisible="wango_delivery_type != 'agency_shipping'" required="wango_delivery_type == 'agency_shipping'"/>
            </xpath>
        </field>
    </record>
</odoo>
