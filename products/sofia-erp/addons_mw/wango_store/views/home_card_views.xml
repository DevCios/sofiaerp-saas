<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_wango_home_card_tree" model="ir.ui.view">
        <field name="name">wango.home.card.tree</field>
        <field name="model">wango.home.card</field>
        <field name="arch" type="xml">
            <list string="Tarjetas de Portada" default_order="sequence asc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="card_type"/>
                <field name="button_text"/>
                <field name="url_redirect"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wango_home_card_form" model="ir.ui.view">
        <field name="name">wango.home.card.form</field>
        <field name="model">wango.home.card</field>
        <field name="arch" type="xml">
            <form string="Tarjeta de Portada">
                <sheet>
                    <field name="is_active" widget="boolean_toggle" class="oe_right"/>
                    <field name="icon_image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Título de la Tarjeta"/>
                        <h1>
                            <field name="name" placeholder="Ej: Más vendidos, Compra protegida..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración del Contenido">
                            <field name="card_type"/>
                            <field name="subtitle" placeholder="Ej: Explora los productos que son tendencia."/>
                            <field name="button_text" placeholder="Ej: Ir a Más vendidos"/>
                            <field name="url_redirect" placeholder="Ej: /shop?order=website_sequence+asc"/>
                        </group>
                        <group string="Presentación">
                            <field name="sequence"/>
                            <field name="icon_class" placeholder="fa fa-shopping-bag (si no subes imagen)"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-3" role="alert">
                        <strong>Tip:</strong> Las primeras 6 tarjetas activas aparecerán en el primer bloque visible frontal. El resto se deslizarán horizontalmente mediante la flecha derecha.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wango_home_card" model="ir.actions.act_window">
        <field name="name">Tarjetas Rápidas de Portada</field>
        <field name="res_model">wango.home.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva tarjeta de acceso rápido para la portada
            </p>
            <p>
                Puedes configurar accesos como: Ingresa a tu cuenta, Ubicación, Favoritos, Tiendas, Más vendidos, etc.
            </p>
        </field>
    </record>
</odoo>
