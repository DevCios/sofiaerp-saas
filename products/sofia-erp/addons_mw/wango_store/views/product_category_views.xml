<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Public Category Form -->
    <record id="product_public_category_form_view_inherit_wango_store" model="ir.ui.view">
        <field name="name">product.public.category.form.inherit.wango.store</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="is_featured_home" widget="boolean_toggle"/>
                <field name="home_sequence" invisible="not is_featured_home"/>
            </xpath>
        </field>
    </record>

    <!-- Window Action: Categorías en Portada -->
    <record id="action_wango_featured_categories" model="ir.actions.act_window">
        <field name="name">Categorías en Portada</field>
        <field name="res_model">product.public.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_featured_home', '=', True)]</field>
        <field name="context">{'default_is_featured_home': True}</field>
    </record>
</odoo>
