<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_wango_home_trust_badge_tree" model="ir.ui.view">
        <field name="name">wango.home.trust.badge.tree</field>
        <field name="model">wango.home.trust.badge</field>
        <field name="arch" type="xml">
            <list string="Beneficios de Confianza" default_order="sequence asc">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="description"/>
                <field name="link_text"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="website_id" groups="website.group_multi_website"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wango_home_trust_badge_form" model="ir.ui.view">
        <field name="name">wango.home.trust.badge.form</field>
        <field name="model">wango.home.trust.badge</field>
        <field name="arch" type="xml">
            <form string="Beneficio de Confianza">
                <sheet>
                    <field name="is_active" widget="boolean_toggle" class="oe_right"/>
                    <field name="icon_image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only" string="Título del Beneficio"/>
                        <h1>
                            <field name="title" placeholder="Ej: Paga con Yape, Envío gratis desde S/ 50..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles Informativos">
                            <field name="description" placeholder="Descripción breve para inspirar confianza..."/>
                            <field name="link_text" placeholder="Ej: Cómo pagar con Yape o tarjetas"/>
                            <field name="link_url" placeholder="Ej: /faq o #"/>
                        </group>
                        <group string="Opciones">
                            <field name="sequence"/>
                            <field name="icon_class" placeholder="fa fa-credit-card (si no subes imagen)"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wango_home_trust_badge" model="ir.actions.act_window">
        <field name="name">Beneficios de Confianza</field>
        <field name="res_model">wango.home.trust.badge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
