<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mw_webhook_outbox_list" model="ir.ui.view">
        <field name="name">mw.webhook.outbox.list</field>
        <field name="model">mw.webhook.outbox</field>
        <field name="arch" type="xml">
            <list string="Cola de Webhooks hacia SOFIA ERP">
                <field name="name"/>
                <field name="order_id"/>
                <field name="seller_id"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-warning="state in ('pending', 'retry')" decoration-danger="state == 'failed'"/>
                <field name="attempt_count"/>
                <field name="last_http_status"/>
                <field name="next_retry_at"/>
                <field name="delivered_at"/>
                <button name="action_deliver_now" string="Enviar Ahora" type="object" icon="fa-paper-plane" invisible="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="action_mw_webhook_outbox" model="ir.actions.act_window">
        <field name="name">Cola de Sincronización ERP</field>
        <field name="res_model">mw.webhook.outbox</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mw_webhook_outbox"
              name="Cola Sync ERP"
              parent="wango_marketplace.menu_admin_marketplace"
              action="action_mw_webhook_outbox"
              sequence="40"
              groups="wango_marketplace.group_marketplace_manager"/>
</odoo>
