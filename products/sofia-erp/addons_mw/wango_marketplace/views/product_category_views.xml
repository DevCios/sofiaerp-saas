<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_inherit_wango_marketplace" model="ir.ui.view">
        <field name="name">product.category.form.inherit.wango_marketplace</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="marketplace" string="Configuración Marketplace">
                    <field name="marketplace_commission_rate" widget="percentage"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
