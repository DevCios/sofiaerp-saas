<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="seller_onboarding_form_template" name="Vende con Nosotros">
            <t t-call="website.layout">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                                <div class="card-body p-5">
                                    <h2 class="text-center fw-bold mb-4">Vende con WanGO</h2>
                                    <p class="text-muted text-center mb-5">Llega a miles de clientes locales. Llena tus datos y nuestro equipo te contactará para aprobar tu tienda.</p>
                                    
                                    <form action="/vende-con-nosotros/submit" method="post" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        
                                        <div class="mb-3">
                                            <label for="company_name" class="form-label fw-semibold">Nombre de tu Tienda / Negocio *</label>
                                            <input type="text" class="form-control" name="company_name" id="company_name" required="1" placeholder="Ej: ElectroPeru SAC"/>
                                        </div>
                                        
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="vat" class="form-label fw-semibold">RUC *</label>
                                                <input type="text" class="form-control" name="vat" id="vat" required="1"/>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="category" class="form-label fw-semibold">¿Qué vendes?</label>
                                                <select class="form-select" name="category" id="category">
                                                    <option value="Restaurante">Restaurante / Comida</option>
                                                    <option value="Tecnologia">Tecnología y Electrónica</option>
                                                    <option value="Ropa">Moda y Ropa</option>
                                                    <option value="Hogar">Hogar y Muebles</option>
                                                    <option value="Otros">Otros</option>
                                                </select>
                                            </div>
                                        </div>

                                        <hr class="my-4"/>

                                        <div class="mb-3">
                                            <label for="name" class="form-label fw-semibold">Tu Nombre (Contacto) *</label>
                                            <input type="text" class="form-control" name="name" id="name" required="1"/>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label for="email" class="form-label fw-semibold">Correo Electrónico *</label>
                                                <input type="email" class="form-control" name="email" id="email" required="1"/>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label for="phone" class="form-label fw-semibold">Teléfono / Celular *</label>
                                                <input type="tel" class="form-control" name="phone" id="phone" required="1"/>
                                            </div>
                                        </div>

                                        <div class="d-grid gap-2 mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg fw-bold" style="border-radius: 8px;">Enviar Solicitud</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="seller_onboarding_success_template" name="Solicitud Enviada">
            <t t-call="website.layout">
                <div class="container py-5 text-center">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <i class="fa fa-check-circle text-success mb-3" style="font-size: 5rem;"></i>
                            <h2 class="fw-bold mb-3">¡Solicitud recibida con éxito!</h2>
                            <p class="text-muted fs-5 mb-4">Hemos registrado los datos de tu tienda. Nuestro equipo de administración revisará tu solicitud y te enviaremos un correo con tus accesos muy pronto.</p>
                            <a href="/" class="btn btn-outline-primary fw-bold px-4 py-2" style="border-radius: 8px;">Volver a la tienda</a>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
