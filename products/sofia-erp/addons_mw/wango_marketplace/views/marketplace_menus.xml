<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MENÚS PARA VENDEDORES -->
    <menuitem id="menu_seller_store"
              name="Mi Tienda"
              parent="wango_core.menu_wango_root"
              groups="wango_marketplace.group_marketplace_seller"
              sequence="10"/>

    <record id="action_seller_products" model="ir.actions.act_window">
        <field name="name">Mis Productos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('marketplace_seller_id.user_ids', '=', uid)]</field>
    </record>

    <menuitem id="menu_seller_products"
              name="Mis Productos"
              parent="menu_seller_store"
              action="action_seller_products"
              sequence="10"/>

    <record id="action_seller_sales" model="ir.actions.act_window">
        <field name="name">Mis Ventas</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('marketplace_seller_id.user_ids', '=', uid)]</field>
    </record>

    <menuitem id="menu_seller_sales"
              name="Mis Ventas"
              parent="menu_seller_store"
              action="action_seller_sales"
              sequence="20"/>

    <!-- MENÚS PARA ADMINISTRADORES -->
    <menuitem id="menu_admin_marketplace"
              name="Administración"
              parent="wango_core.menu_wango_root"
              groups="wango_marketplace.group_marketplace_manager"
              sequence="20"/>

    <!-- Vendedores Pendientes -->
    <record id="action_admin_pending_sellers" model="ir.actions.act_window">
        <field name="name">Vendedores Pendientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_marketplace_seller', '=', True), ('marketplace_seller_status', '=', 'pending')]</field>
    </record>

    <menuitem id="menu_admin_pending_sellers"
              name="Vendedores Pendientes"
              parent="menu_admin_marketplace"
              action="action_admin_pending_sellers"
              sequence="10"/>

    <!-- Vendedores Aprobados -->
    <record id="action_admin_approved_sellers" model="ir.actions.act_window">
        <field name="name">Vendedores Aprobados</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_marketplace_seller', '=', True), ('marketplace_seller_status', '=', 'approved')]</field>
    </record>

    <menuitem id="menu_admin_approved_sellers"
              name="Vendedores Aprobados"
              parent="menu_admin_marketplace"
              action="action_admin_approved_sellers"
              sequence="15"/>

    <!-- Productos Pendientes -->
    <record id="action_admin_pending_products" model="ir.actions.act_window">
        <field name="name">Productos Pendientes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('marketplace_status', '=', 'pending')]</field>
    </record>

    <menuitem id="menu_admin_pending_products"
              name="Productos Pendientes"
              parent="menu_admin_marketplace"
              action="action_admin_pending_products"
              sequence="20"/>

    <!-- Productos Aprobados -->
    <record id="action_admin_approved_products" model="ir.actions.act_window">
        <field name="name">Productos Aprobados</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('marketplace_status', '=', 'approved')]</field>
    </record>

    <menuitem id="menu_admin_approved_products"
              name="Productos Aprobados"
              parent="menu_admin_marketplace"
              action="action_admin_approved_products"
              sequence="25"/>

    <!-- Categorías y Comisiones -->
    <record id="action_admin_categories" model="ir.actions.act_window">
        <field name="name">Comisiones por Categoría</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_admin_categories"
              name="Categorías y Comisiones"
              parent="menu_admin_marketplace"
              action="action_admin_categories"
              sequence="30"/>
</odoo>
