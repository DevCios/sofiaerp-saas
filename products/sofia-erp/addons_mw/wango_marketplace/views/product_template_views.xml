<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_wango_marketplace" model="ir.ui.view">
        <field name="name">product.template.form.inherit.wango_marketplace</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Marketplace" name="marketplace_info">
                    <div class="mb-3" groups="wango_marketplace.group_marketplace_manager" invisible="marketplace_status != 'pending'">
                        <button string="Aprobar en Marketplace"
                                type="object"
                                name="action_approve_product"
                                class="oe_highlight btn-success me-2"/>
                        <button string="Rechazar Producto"
                                type="object"
                                name="action_reject_product"
                                class="btn-danger"/>
                    </div>
                    <group>
                        <group string="Vendedor Asignado">
                            <field name="marketplace_seller_id"/>
                            <field name="marketplace_status" readonly="1"/>
                        </group>
                        <group string="Reputación de la Tienda Asignada" invisible="not marketplace_seller_id">
                            <field name="seller_is_official_store" widget="boolean_toggle"/>
                            <field name="seller_sales_completed"/>
                            <field name="seller_rating_avg"/>
                            <field name="seller_rating_count"/>
                            <field name="seller_on_time_delivery_pct"/>
                            <field name="seller_good_service_pct"/>
                        </group>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>
</odoo>
