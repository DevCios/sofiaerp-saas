<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_settlement_form" model="ir.ui.view">
        <field name="name">marketplace.settlement.form</field>
        <field name="model">marketplace.settlement</field>
        <field name="arch" type="xml">
            <form string="Liquidación">
                <header>
                    <button name="action_fetch_lines" string="Cargar Ventas" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_confirm" string="Confirmar Liquidación" type="object" invisible="state != 'draft'" class="btn-success"/>
                    <button name="action_create_commission_invoice" string="Facturar Comisión" type="object" invisible="state != 'confirmed' or commission_invoice_id" class="btn-secondary"/>
                    <button name="action_pay" string="Liquidar y Marcar Pagado" type="object" invisible="state != 'confirmed'" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="seller_id" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="only_delivered_escrow" widget="boolean_toggle" readonly="state != 'draft'"/>
                            <field name="commission_invoice_id" invisible="not commission_invoice_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="commission_variable_total" widget="monetary"/>
                            <field name="platform_fee_total" widget="monetary"/>
                            <field name="commission_total" widget="monetary"/>
                            <field name="amount_to_pay" widget="monetary" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Venta">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="order_id"/>
                                    <field name="product_id"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="marketplace_commission_rate" widget="percentage"/>
                                    <field name="marketplace_commission_amount" sum="Comisiones"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketplace_settlement_tree" model="ir.ui.view">
        <field name="name">marketplace.settlement.tree</field>
        <field name="model">marketplace.settlement</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_to_pay"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-primary="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_settlement" model="ir.actions.act_window">
        <field name="name">Liquidaciones a Vendedores</field>
        <field name="res_model">marketplace.settlement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú en Finanzas y Escrow -->
    <menuitem id="menu_marketplace_settlements"
              name="Liquidaciones Escrow"
              parent="wango_marketplace.menu_mw_finance"
              action="action_marketplace_settlement"
              sequence="10"
              groups="wango_marketplace.group_marketplace_manager"/>

</odoo>
