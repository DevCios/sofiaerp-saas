<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Privilegio Odoo 20: Marketplace (selector desplegable limpio bajo sección Mercado Wanka) -->
        <record id="privilege_wango_marketplace" model="res.groups.privilege">
            <field name="name">Marketplace</field>
            <field name="category_id" ref="wango_core.module_category_mercado_wanka"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_marketplace_seller" model="res.groups">
            <field name="name">Vendedor</field>
            <field name="privilege_id" ref="wango_marketplace.privilege_wango_marketplace"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Vendedor de Mercado Wanka con acceso restringido a su tienda, productos y ventas.</field>
        </record>

        <record id="group_marketplace_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="privilege_id" ref="wango_marketplace.privilege_wango_marketplace"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('wango_marketplace.group_marketplace_seller'))]"/>
            <field name="comment">Administra todos los vendedores, productos, comisiones y liquidaciones de Mercado Wanka.</field>
        </record>
    </data>
</odoo>
