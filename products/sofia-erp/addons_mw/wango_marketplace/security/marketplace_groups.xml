<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_marketplace_seller" model="res.groups">
            <field name="name">Mercado Wanka: Vendedor</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">El usuario es un vendedor de Mercado Wanka restringido a sus propios datos.</field>
        </record>

        <record id="group_marketplace_manager" model="res.groups">
            <field name="name">Mercado Wanka: Administrador</field>
            <field name="implied_ids" eval="[(4, ref('wango_marketplace.group_marketplace_seller'))]"/>
            <field name="comment">Administra todos los vendedores, productos, comisiones y liquidaciones de Mercado Wanka.</field>
        </record>
    </data>
</odoo>
