# ==============================================================================
# SOFIA ERP — Variables de Entorno de Referencia (.env.example)
# ADVERTENCIA: NUNCA almacenes contraseñas de producción ni secretos reales en Git.
# Copia este archivo como .env y genera valores criptográficos únicos con:
# openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# Entorno General de la Plataforma
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=generate_with_openssl_rand_hex_32_change_in_production
ALLOWED_HOSTS=sofiaerp.com,*.sofiaerp.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Base de Datos Central de SOFIA Platform (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sofia_admin
POSTGRES_PASSWORD=generate_secure_password_min_24_chars
POSTGRES_DB=sofia_central_db

# Cadena de conexión para SQLAlchemy (Asyncpg para FastAPI)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Connection Pooler (PgBouncer)
# ------------------------------------------------------------------------------
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ------------------------------------------------------------------------------
# Caché, Sesiones y Broker Asíncrono (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_secure_redis_auth_token
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ------------------------------------------------------------------------------
# Celery (Aprovisionamiento y Tareas en Segundo Plano)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2

# ------------------------------------------------------------------------------
# Identidad Central, OAuth 2.0 y Tokens JWT (Asimétrico RS256)
# ------------------------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_PRIVATE_KEY_PATH=/etc/sofia/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/sofia/keys/jwt_public.pem

# ------------------------------------------------------------------------------
# Rutas Físicas del Sistema (Volúmenes Aislados)
# ------------------------------------------------------------------------------
SOFIA_DATA_ROOT=/var/lib/sofia
SOFIA_FILESTORES_DIR=/var/lib/sofia/filestores
SOFIA_BACKUPS_DIR=/var/lib/sofia/backups

# ------------------------------------------------------------------------------
# Almacenamiento Externo para Backups (Google Drive / S3)
# ------------------------------------------------------------------------------
BACKUP_STORAGE_DRIVER=google_drive
RCLONE_CONFIG_PATH=/etc/sofia/rclone/rclone.conf
GOOGLE_DRIVE_FOLDER_ID=sofia_backups_folder_id

# ------------------------------------------------------------------------------
# Configuración Odoo Runtime Pool (Shared Protected)
# ------------------------------------------------------------------------------
ODOO_IMAGE=odoo:20.0
ODOO_ADMIN_PASSWORD=generate_secure_master_password_odoo
ODOO_DB_USER=odoo_runtime_user
ODOO_DB_PASSWORD=generate_secure_odoo_db_password
ODOO_WORKERS=6
ODOO_LIMIT_MEMORY_HARD=1073741824
ODOO_LIMIT_MEMORY_SOFT=838860800
ODOO_LIMIT_TIME_CPU=60
ODOO_LIMIT_TIME_REAL=120
