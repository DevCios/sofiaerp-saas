# ==============================================================================
# API SUNAT Pro — Dominio Principal (apisunat.pro, www.apisunat.pro, docs.apisunat.pro)
# Copiar a infrastructure/docker/nginx/conf.d/apisunat.pro.conf DESPUÉS de emitir SSL con Certbot.
# ==============================================================================

server {
    listen 80;
    server_name apisunat.pro www.apisunat.pro docs.apisunat.pro;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name apisunat.pro www.apisunat.pro;

    ssl_certificate /etc/letsencrypt/live/apisunat.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apisunat.pro/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 15M;

    if ($host = www.apisunat.pro) {
        return 301 https://apisunat.pro$request_uri;
    }

    location / {
        proxy_pass http://sunat_gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl;
    server_name docs.apisunat.pro;

    ssl_certificate /etc/letsencrypt/live/apisunat.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apisunat.pro/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location = / {
        return 302 https://docs.apisunat.pro/docs-portal;
    }

    location / {
        proxy_pass http://sunat_gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
