# ==============================================================================
# SOFIA ERP — Nginx Enrutamiento Perimetral y SSL Let's Encrypt (HTTPS)
# ==============================================================================

# Upstream hacia el Control Plane API (FastAPI)
upstream control_plane_backend {
    server control-plane-api:8000;
    keepalive 32;
}

# Upstream hacia el Runtime Pool de Odoo Community
upstream odoo_backend {
    server odoo-runtime:8069;
    keepalive 32;
}

# Redirección global HTTP -> HTTPS (excepto acme-challenge para renovaciones)
server {
    listen 80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirección amigable de /login hacia /web/login
    location = /login {
        return 301 /web/login;
    }

    # Manejo amigable de subdominios inexistentes o erróneos:
    # Si el tenant no existe o hay error en subdominio, redirigir automáticamente al login central
    error_page 401 403 404 500 =302 https://sofiaerp.com/login;

    location / {
        return 301 https://$host$request_uri;
    }
}

# Servidor HTTPS de Plataforma Central: api.sofiaerp.com, auth.sofiaerp.com, admin
server {
    listen 443 ssl;
    server_name api.sofiaerp.com auth.sofiaerp.com admin.sofiaerp.com localhost;

    ssl_certificate /etc/letsencrypt/live/sofiaerp.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sofiaerp.com-0001/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Enrutamiento directo a Odoo por IP para interfaz web, login y websockets
    location ~* ^/(web|websocket|longpolling) {
        proxy_pass http://odoo_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 120s;
        proxy_read_timeout 300s;
    }

    # Enrutamiento hacia Control Plane API y Dashboard Admin
    # Redirección amigable de /login hacia /web/login
    location = /login {
        return 301 /web/login;
    }

    # Manejo amigable de subdominios inexistentes o erróneos:
    # Si el tenant no existe o hay error en subdominio, redirigir automáticamente al login central
    error_page 401 403 404 500 =302 https://sofiaerp.com/login;

    location / {
        proxy_pass http://control_plane_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
    }
}

# ==============================================================================
# Sitio Web Corporativo Institucional HTTPS (sofiaerp.com y www.sofiaerp.com)
# ==============================================================================
server {
    listen 443 ssl;
    server_name sofiaerp.com www.sofiaerp.com;

    ssl_certificate /etc/letsencrypt/live/sofiaerp.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sofiaerp.com-0001/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Redirección amigable de /login hacia /web/login
    location = /login {
        return 301 /web/login;
    }

    # Manejo amigable de subdominios inexistentes o erróneos:
    # Si el tenant no existe o hay error en subdominio, redirigir automáticamente al login central
    error_page 401 403 404 500 =302 https://sofiaerp.com/login;

    location / {
        proxy_pass http://odoo_backend;
        proxy_http_version 1.1;
        proxy_set_header Host sofiaerp.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Odoo-dbfilter sofia_tenant_sofiaerp;

        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 300s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location ~* /web/static/ {
        proxy_pass http://odoo_backend;
        proxy_cache_valid 200 60m;
        proxy_buffering on;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}

# Servidor HTTPS para Runtimes de Tenants (*.sofiaerp.com y Dominios Personalizados)
server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/sofiaerp.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sofiaerp.com-0001/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location /api/ {
        proxy_pass http://control_plane_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /_sofia_resolve_tenant {
        internal;
        proxy_pass http://control_plane_backend/api/v1/tenants/resolve/$host;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
    }

    # Redirección amigable de /login hacia /web/login
    location = /login {
        return 301 /web/login;
    }

    # Manejo amigable de subdominios inexistentes o erróneos:
    # Si el tenant no existe o hay error en subdominio, redirigir automáticamente al login central
    error_page 401 403 404 500 =302 https://sofiaerp.com/login;

    location / {
        auth_request /_sofia_resolve_tenant;
        auth_request_set $dynamic_dbfilter $upstream_http_x_odoo_dbfilter;

        proxy_pass http://odoo_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Odoo-dbfilter $dynamic_dbfilter;

        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 300s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location ~* /web/static/ {
        proxy_pass http://odoo_backend;
        proxy_cache_valid 200 60m;
        proxy_buffering on;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }
}
